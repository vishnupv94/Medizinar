<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to the app directory
    RewriteRule ^app/ - [F,L]

    # Block access to database directory
    RewriteRule ^database/ - [F,L]

    # Block access to hidden files and directories
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Allow blog image uploads to be served publicly
    RewriteRule ^uploads/blog/.+\.(jpe?g|png|webp)$ - [L]

    # Block access to uploads directory listing
    RewriteRule ^uploads/ - [F,L]

    # Allow existing files and directories to pass through
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route all other requests to front controller
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Production PHP settings
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.save_path "/tmp"
</IfModule>
<IfModule lsapi_module>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.save_path "/tmp"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Vary "Accept-Encoding"
</IfModule>

# Browser caching for static assets — improves Core Web Vitals / PageSpeed
<IfModule mod_expires.c>
    ExpiresActive On

    # Fonts
    ExpiresByType font/woff2                     "access plus 1 year"
    ExpiresByType font/woff                      "access plus 1 year"
    ExpiresByType application/font-woff2         "access plus 1 year"

    # CSS and JS
    ExpiresByType text/css                       "access plus 6 months"
    ExpiresByType application/javascript         "access plus 6 months"
    ExpiresByType text/javascript                "access plus 6 months"

    # Images
    ExpiresByType image/png                      "access plus 1 year"
    ExpiresByType image/jpg                      "access plus 1 year"
    ExpiresByType image/jpeg                     "access plus 1 year"
    ExpiresByType image/webp                     "access plus 1 year"
    ExpiresByType image/gif                      "access plus 1 year"
    ExpiresByType image/svg+xml                  "access plus 6 months"
    ExpiresByType image/x-icon                   "access plus 1 year"

    # Webmanifest
    ExpiresByType application/manifest+json      "access plus 1 week"
    ExpiresByType application/json               "access plus 0 seconds"

    # HTML — no cache (always fresh)
    ExpiresByType text/html                      "access plus 0 seconds"
</IfModule>

# Cache-Control fallback (for servers without mod_expires)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff)$">
        Header set Cache-Control "public, max-age=15552000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.webmanifest$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Block access to sensitive file types
<FilesMatch "\.(env|log|sql|bak|sh|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>


# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
